# ─── Frontend (Vite) ─────────────────────
# Vite only exposes variables prefixed with VITE_. Create a `.env` file in this
# folder (same folder as vite.config.ts) and copy the values you need.

# Deployed builds: point at the hosted API (no trailing slash).
# Leave unset locally — the Vite dev server proxies /api to the backend.
VITE_API_URL=

# Google Sign-In (optional).
# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (Web application). Add this app's URL to "Authorized JavaScript origins".
# Must match GOOGLE_CLIENT_ID in backend/.env. Leave blank to hide the
# "Continue with Google" button — phone code and password login still work.
VITE_GOOGLE_CLIENT_ID=
