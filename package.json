{
  "name": "sawaba-grooming-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "cd backend && npm run dev",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "build": "node scripts/prepare-prisma.js && prisma generate && node scripts/sync-prisma.js && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "prisma:prepare": "node scripts/prepare-prisma.js",
    "prisma:generate": "node scripts/prepare-prisma.js && prisma generate && node scripts/sync-prisma.js",
    "prisma:push": "node scripts/prepare-prisma.js && prisma db push",
    "db:use:mysql": "DB_PROVIDER=mysql node scripts/prepare-prisma.js && prisma generate && node scripts/sync-prisma.js",
    "db:use:postgres": "DB_PROVIDER=postgresql node scripts/prepare-prisma.js && prisma generate && node scripts/sync-prisma.js",
    "db:push": "node scripts/prepare-prisma.js && prisma db push && node scripts/sync-prisma.js",
    "db:seed": "node scripts/sync-prisma.js && tsx backend/src/scripts/seed.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^13.2.0",
    "google-auth-library": "^11.1.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.45.0",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^10.0.10",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "resend": "^6.28.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.7",
    "@vitejs/plugin-react": "^6.1.1",
    "heic-convert": "^2.1.0",
    "jimp": "^1.6.1",
    "oxlint": "^1.81.0",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.2",
    "typescript": "~5.7.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0"
  }
}
