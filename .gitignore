# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr

# Environment files — these hold JWT secrets, admin passwords and API keys.
# Only the *.example templates are committed.
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example

# Locally uploaded images (barbers/gallery/services/receipts) — runtime data,
# but the shipped seed copies in backend/seed-assets are committed
backend/uploads
*.local

# deploy/ ships a prebuilt backend bundle (compiled dist + prod deps manifest)
!deploy/dist/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
